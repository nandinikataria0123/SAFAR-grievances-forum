# Copy this file to .env for the local export script, and set the same
# values as Supabase Edge Function secrets for the webhook (see README).

# --- Meta WhatsApp Cloud API ---
# developers.facebook.com > your app > WhatsApp > API Setup
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
# You choose this string yourself. Enter the same value in the Meta
# webhook config screen.
META_VERIFY_TOKEN=
# Used to verify incoming webhook signatures. Meta app dashboard > Settings > Basic.
META_APP_SECRET=

# --- Supabase ---
SUPABASE_URL=
# Service role key: Project Settings > API. Full access, keep this private,
# never expose it to a client or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Bhashini ---
# bhashini.gov.in > sign up > My Profile > Generate API key
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_AUTH_TOKEN=
# ISO language code of the audio coming in, e.g. kn (Kannada), hi (Hindi).
# Leave blank to ask the worker or default to Hindi.
BHASHINI_SOURCE_LANG=hi
